{
  "name": "@breign/chat",
  "version": "0.1.0",
  "description": "Chat Breign embarquable. Appelle brain-api à partir d'une URL et d'en-têtes fournis par l'application hôte.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p demo/tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "vite --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "@breign/client": ">=1.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.476.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.1",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@breign/client": "file:../brain-client",
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.8.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "license": "ISC"
}
